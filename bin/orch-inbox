#!/usr/bin/env bash
# orch-inbox — inspect or consume an agent inbox.
#
# Usage:
#   orch-inbox peek <agent-id>       # print unread messages without archiving
#   orch-inbox check <agent-id>      # print + archive unread messages
#   orch-inbox archive <agent-id>    # print archived messages
#   orch-inbox --help
#
# Operator note:
#   Prefer `peek`. `check` marks unread messages as read for the agent.

set -euo pipefail
: "${ORCHESTRATION_HOME:=$HOME/orchestration}"
export ORCHESTRATION_HOME
source "$ORCHESTRATION_HOME/lib/common.sh"

usage() { awk 'NR==1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; }

case "${1:-}" in
  -h|--help|"") usage; exit 0 ;;
esac

export ORCH_PROJECT="$PWD"
[[ -f "$(roster_file)" ]] || die "no session in $(agents_dir)"

cmd="$1"; shift
id="${1:-}"
[[ -n "$id" ]] || die "agent id required"

case "$cmd" in
  peek)    bash "$ORCHESTRATION_HOME/lib/protocol.sh" peek-inbox "$id" ;;
  check)   bash "$ORCHESTRATION_HOME/lib/protocol.sh" check-inbox "$id" ;;
  archive) bash "$ORCHESTRATION_HOME/lib/protocol.sh" check-archive "$id" ;;
  *) die "unknown command: $cmd (try: orch-inbox --help)" ;;
esac
